# Backend — variables d'environnement
# (En développement local, il suffit de DEBUG=True : SQLite + clé jetable +
#  FileSystemStorage. Les variables ci-dessous concernent la production.)
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Base de données PostgreSQL managée (Neon). SSL forcé automatiquement.
DATABASE_URL=postgres://user:password@host.neon.tech:5432/dbname?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://votre-front.vercel.app
CSRF_TRUSTED_ORIGINS=https://votre-front.vercel.app

# Stockage objet S3-compatible (Supabase Storage) — le filesystem de Render est
# éphémère, sans ça les pièces justificatives disparaîtraient à chaque déploiement.
# Laisser vide en local pour rester sur le FileSystemStorage.
AWS_STORAGE_BUCKET_NAME=attestations
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-west-3
# AWS_S3_ADDRESSING_STYLE=path        # défaut : path (requis par Supabase)
# AWS_QUERYSTRING_EXPIRE=3600         # durée de vie des URLs présignées (s)

# Seed des comptes de démo — désactivé par défaut hors DEBUG. Pour amorcer un
# environnement de démo dédié uniquement : SEED_DEMO=1 et DEMO_PASSWORD obligatoire.
# (Le superuser se crée séparément via `python manage.py createsuperuser`.)
# SEED_DEMO=1
# DEMO_PASSWORD=change-me
